# Copy to .env.local; keep credentials out of Git.
# Local blog generation
OPENAI_API_KEY=
GEMINI_API_KEY=

# Slack Socket Mode service (npm run bot:slack)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# Optional comma-separated channel IDs; empty permits all app-accessible channels.
SLACK_ALLOWED_CHANNELS=
# review saves locally; automatic publishing requires an intentional change to auto.
SUANLAB_PUBLISH_MODE=review

# Optional public search-console verification IDs
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
